# NF-23…NF-26 verification session artifacts — scratch evidence, never product.
# The phase reports cite these paths, and the reports already call them untracked:
# a probe script is a throwaway driver for one measurement, not code the app ships.
# Ignored wholesale so none of it can be committed again; rerunning a report's repro
# command recreates the script, and the measurements it quoted stay in the report.
/.nc*/
/.nc_*

# NovaMarket frontend dependencies and generated TypeScript metadata
web/node_modules/
web/*.tsbuildinfo

# Local NovaMarket QA, browser, screenshot, and runtime output
.ui_audit/
.runtime/

# One-off PI evaluation scratch written to the repository root (driver output,
# server logs). The PI reports keep their measured results; these files do not
# need to be in the tree.
/tmp_pi*.json
/tmp_pi*.log

# Stage C 27 November acceptance driver and working notes; evidence is preserved
# separately under the isolated tmp/stage_c_v2_2026_11_27 directories.
/.planning/2026-11-27-stage-c-acceptance/

# SQLite sidecars written beside every store (data/, and the isolated Stage C
# acceptance stores under the already-ignored tmp/ tree).
*.sqlite3-wal
*.sqlite3-shm

# Stage C per-file suite ledger/logs and 5m backfill helpers live under tmp/,
# which is ignored above; these guard the copies made outside it.
/tmp_stage_c*
/stage_c_evidence*/
