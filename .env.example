[TEMPLATE]
NOVACONTROL_ENV=development
NOVACONTROL_LOG_LEVEL=INFO
NOVACONTROL_DATABASE_URL=sqlite:///data/novacontrol.sqlite3
NOVACONTROL_REDIS_URL=redis://localhost:6379/0
NOVACONTROL_REQUIRE_APPROVAL=true

# API Authentication (optional)
# NOVACONTROL_API_TOKEN=your-secret-token-here

# External LLM (disabled by default)
# NOVACONTROL_ENABLE_EXTERNAL_LLM=true
# NOVACONTROL_LLM_NAME=openai-compatible
# NOVACONTROL_LLM_MODEL=gpt-4
# NOVACONTROL_LLM_BASE_URL=https://api.openai.com
# NOVACONTROL_LLM_API_KEY=your-api-key-here
# OPENAI_API_KEY=your-api-key-here

# NovaMarket operator email notifications (SMTP).
# Recipient, thresholds and switches are NovaMarket configuration
# (GET/POST /market/config). These transport credentials are read from the
# server environment and are never returned by any API.
# Port 587 uses STARTTLS; port 465 uses implicit TLS.
# NOVAMARKET_SMTP_HOST=smtp.gmail.com
# NOVAMARKET_SMTP_PORT=587
# NOVAMARKET_SMTP_USER=you@example.com
# NOVAMARKET_SMTP_PASSWORD=your-app-password
# NOVAMARKET_SMTP_FROM=you@example.com
# NOVAMARKET_SMTP_TLS=true

# Market-data providers and ingestion are NovaMarket configuration, not process
# environment. POST /market/config with a partial payload, e.g.
#   {"data_providers": ["yahoo"], "ingestion": {"enabled": true,
#    "poll_seconds": 60, "include_quotes": true, "include_bars": true,
#    "run_when_closed": false}}
# Yahoo data is delayed/unofficial. Millisecond freshness needs a licensed
# real-time provider; this build does not fabricate one.
