[TEMPLATE]
NOVACONTROL_ENV=development
NOVACONTROL_LOG_LEVEL=INFO
NOVACONTROL_DATABASE_URL=sqlite:///data/novacontrol.sqlite3
NOVACONTROL_REDIS_URL=redis://localhost:6379/0
NOVACONTROL_REQUIRE_APPROVAL=true

# API Authentication (optional)
# NOVACONTROL_API_TOKEN=your-secret-token-here

# External LLM (disabled by default)
# NOVACONTROL_ENABLE_EXTERNAL_LLM=true
# NOVACONTROL_LLM_NAME=openai-compatible
# NOVACONTROL_LLM_MODEL=gpt-4
# NOVACONTROL_LLM_BASE_URL=https://api.openai.com
# NOVACONTROL_LLM_API_KEY=your-api-key-here
# OPENAI_API_KEY=your-api-key-here
